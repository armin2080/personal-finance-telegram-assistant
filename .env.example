# Copy to .env and fill in real values. Never commit the real .env file.
# Keep the filled-in file at mode 0600.

# Required to run the Telegram bot. Create it with @BotFather.
# Leave empty to run only the CLI and the web cockpit.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs. The bot refuses to start when this
# is empty or malformed, and it ignores every other user and every group chat.
TELEGRAM_ALLOWED_USER_IDS=

# Absolute path to the SQLite database. Keep it outside this repository.
FPA_DATABASE_PATH=/var/lib/personal-finance-assistant/finance.sqlite3

# Timezone used for user-facing month and day boundaries.
FPA_USER_TIMEZONE=Europe/Berlin

# Operational log level: DEBUG, INFO, WARNING, ERROR.
FPA_LOG_LEVEL=INFO

# Refuse writes when free disk drops below this many bytes (default 100 MiB).
FPA_MIN_FREE_BYTES=104857600

# Maximum accepted Telegram CSV upload size in bytes (default 10 MiB).
FPA_MAX_UPLOAD_BYTES=10485760
