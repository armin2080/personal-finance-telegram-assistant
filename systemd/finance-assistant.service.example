[Unit]
Description=Personal Finance Telegram Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=financebot
Group=financebot
WorkingDirectory=/opt/personal-finance-assistant
EnvironmentFile=/etc/finance-assistant/bot.env
Environment=PYTHONUNBUFFERED=1
Environment=FPA_MIN_FREE_BYTES=104857600
ExecStart=/opt/personal-finance-assistant/.venv/bin/finance-assistant bot
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# systemd hardening. Verify paths and compatibility before enabling.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/finance-assistant
StateDirectory=finance-assistant
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
